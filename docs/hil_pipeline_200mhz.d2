direction: right

hil: "HIL FPGA datapath" {
  shape: rectangle

  axi: "AXI / UI domain\nclk_fpga_0 = 100 MHz" {
    pwm_ctrl: "PWM / controller regs\n100 MHz"
    params: "Motor params / coeff writes\naccepted only when solver idle"
    decimator: "Output decimator\ndefault 750"
    dma: "AXI4-Stream DMA\n~10.26 kS/s default"
  }

  cdc_in: "CDC / registered inputs\n100 MHz -> 200 MHz" {
    shape: queue
  }

  solver_clk: "Solver domain\nclk_fpga_1 = 200 MHz" {
    voltages: "Va,Vb,Vc input registers\nupdated from HIL top"

    clarke: "ClarkeTransform\nstreaming, data_valid_i = 1" {
      in_regs: "Stage 0\nABC regs"
      sums: "Stage 1-2\nalpha/beta sums + register"
      mult: "ClarkeMultiplier_DSP\n2 DSP mult_gen, 7-cycle IP"
      out_regs: "Output regs\nvalid latency = 11 cycles"
    }

    timer: "Discretization timer\n26 clocks @ 200 MHz\nTs = 130 ns"
    gate: "solver_start = timer_tick\nand not solver_busy\nand not state_clear"

    solver: "TIMSolverHandler\n5 parallel rows" {
      bsu: "BilinearSolverUnit per state" {
        op_regs: "Product1 register + coeff mux\naligned to DSP stage 2"
        mult1: "DSP mult 1\nX*X_Y or B*U\nMULTIPLIER_DELAY = 8"
        round1: "Q14.28 rounding"
        mult2: "DSP mult 2\nproduct1*A or *1\nMULTIPLIER_DELAY = 8"
        accum: "Accumulator\nsum 8 operations\nN_SS=5, N_IN=3"
      }
      done: "solver_done\nfalling edge of busy"
      euler: "Euler update\nX[k+1] = X[k] + dX[k]\ndata_valid_o pulse"
    }
  }

  cdc_out: "CDC / sample pulse toggle\n200 MHz -> 100 MHz" {
    shape: queue
  }
}

hil.axi.pwm_ctrl -> hil.cdc_in: "Va,Vb,Vc / torque / control words"
hil.axi.params -> hil.solver_clk.solver: "A,B,Y coeff writes\nonly while solver_busy=0"
hil.cdc_in -> hil.solver_clk.voltages
hil.solver_clk.voltages -> hil.solver_clk.clarke
hil.solver_clk.clarke -> hil.solver_clk.solver: "valpha,vbeta continuous\nnew result every 5 ns after fill"
hil.solver_clk.timer -> hil.solver_clk.gate: "timer_tick every 26 cycles"
hil.solver_clk.gate -> hil.solver_clk.solver: "one solve request per Ts\nif solver is idle"
hil.solver_clk.solver.done -> hil.solver_clk.solver.euler
hil.solver_clk.solver.euler -> hil.cdc_out: "new state sample\nnominally every 26 cycles"
hil.cdc_out -> hil.axi.decimator
hil.axi.decimator -> hil.axi.dma

note_clarke: "Clarke rate: 200 MS/s after pipeline fill.\nIt is not one Clarke per solver step; there are 26 Clarke cycles per solver period."
note_solver: "Solver rate: one solution every 26 solver clocks = 130 ns = 7.692 MS/s,\nprovided solver_busy is low at timer_tick. If busy is still high, that tick is skipped."

note_clarke -> hil.solver_clk.clarke
note_solver -> hil.solver_clk.gate
