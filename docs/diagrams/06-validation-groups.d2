# =============================================================================
# Figura 06 - Sequencia dos grupos de ensaio da campanha (S0 -> Grupo A -> Grupo
# B -> Grupo C), com o status L2/L3 de cada grupo. Nao detalha parametros
# internos (ver tabela da matriz de parametros no capitulo de resultados).
# =============================================================================

vars: {d2-config: {layout-engine: elk; pad: 40}}
direction: right

classes: {
  box:     {style: {fill: white; stroke: black; stroke-width: 2; border-radius: 0; font-color: black; bold: false}}
  pending: {style: {fill: white; stroke: black; stroke-width: 2; stroke-dash: 4; border-radius: 0; font-color: black; bold: false}}
  arrow:   {style: {stroke: black; stroke-width: 2; font-color: black; bold: false}}
}

s0: "S0 - Sanity\nvalida o pipeline L2/L3" {class: box}
grupo_a: "Grupo A - Partida e Aceleracao\n7 casos (A1-A7)\nL2: 7/7 ok  L3: 7/7 ok" {class: box}
grupo_b: "Grupo B - Degrau de Carga\nB1, B2: L2/L3 ok\nB3: regime nao atingido (reexecucao pendente)" {class: box}
grupo_c: "Grupo C - Dinamica Adicional\nplanejado, nao iniciado" {class: pending}
l4: "L4 - FPGA Real\npendente para todos os grupos" {class: pending}

s0 -> grupo_a: "pipeline validado" {class: arrow}
grupo_a -> grupo_b: "concluido" {class: arrow}
grupo_b -> grupo_c: "planejado" {class: arrow}
grupo_c -> l4: "planejado" {class: arrow}
